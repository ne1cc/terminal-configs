{
  "workmux-status": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "workmux register-agent >/dev/null 2>&1 || true; printf '{}\\n'"
      },
      {
        "type": "command",
        "command": "workmux set-window-status working >/dev/null 2>&1 || true; printf '{}\\n'"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "workmux set-window-status done >/dev/null 2>&1 || true; printf '{}\\n'"
      }
    ]
  }
}

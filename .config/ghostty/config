# =============================================================================
# HARDENED GHOSTTY PRODUCTION PROFILE (macOS MONOSPACE OPTIMIZED)
# =============================================================================

# --- Typography & Core Rendering ---
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
font-thicken = true
adjust-cell-height = 3
grapheme-width-method = unicode

# --- Window Canvas & High-Transparency Compositing ---
# Lower opacity (0.20) yields maximum clarity for background details.
# Disabling blur ensures background stars/objects remain perfectly crisp.
background = #1a1a1a
background-opacity = 0.12
background-blur-radius = 0
window-padding-x = 12
window-padding-y = 12
window-save-state = always

# --- macOS-Specific Window Frame & Tab Optimization ---
window-theme = dark
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
window-padding-balance = true

# --- Input Mechanics & Automation ---
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = true
shell-integration-features = no-cursor
confirm-close-surface = false

# --- Keyboard Pass-Through Integration ---
# Passes meta-keys seamlessly to underlying multiplexers (tmux/Neovim)
macos-option-as-alt = true

# --- Low-Latency Native Multiplexing Keybinds ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+h=goto_split:left
keybind = cmd+l=goto_split:right
keybind = cmd+k=goto_split:top
keybind = cmd+j=goto_split:bottom
unfocused-split-opacity = 0.85

# Auto-attach or create tmux session on launch (force UTF-8 with -u)
command = "/opt/homebrew/bin/tmux -u new-session -A -s main"

# Send explicit escape sequences to allow ctrl+tab and ctrl+shift+tab to pass through to tmux on macOS
keybind = ctrl+tab=esc:[27;5;9~
keybind = ctrl+shift+tab=esc:[27;6;9~

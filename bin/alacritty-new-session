#!/usr/bin/env bash
# alacritty-new-session:
# Launched by Alacritty on new windows.
# Creates a brand new, uniquely named tmux session stamped with the current date & time.

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
export TERMINFO="${TERMINFO:-/usr/share/terminfo}"

tmux_bin="$(command -v tmux 2>/dev/null || echo "$HOME/.local/bin/tmux")"

# Using YYYY-MM-DD_HH-MM format because tmux parses colons ':' as window/pane delimiters (session:window.pane)
base_name="$(date +%Y-%m-%d_%H-%M)"
session_name="$base_name"
counter=2

# Handle multiple windows launched within the same minute
while "$tmux_bin" has-session -t "$session_name" 2>/dev/null; do
    session_name="${base_name}-${counter}"
    counter=$((counter + 1))
done

cd "$HOME" || true
zsh_bin="$(command -v zsh 2>/dev/null || echo "$HOME/.local/bin/zsh")"
exec "$tmux_bin" new-session -s "$session_name" "$zsh_bin"

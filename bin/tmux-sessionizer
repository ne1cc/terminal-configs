#!/usr/bin/env bash
# tmux-sessionizer — ~/Github/<owner>/<repo> + ~/Github/_local/projects/<name>
set -euo pipefail

GITHUB_ROOT="${GITHUB_ROOT:-$HOME/Github}"

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
      {
        fd -L --min-depth 2 --max-depth 2 -t d \
          --exclude '_local' \
          --exclude '_*' \
          --exclude '.*' . "$GITHUB_ROOT" 2>/dev/null
        fd -L --min-depth 1 --max-depth 1 -t d . "$GITHUB_ROOT/_local/projects" 2>/dev/null
      } | LC_ALL=C sort -u | fzf --prompt='repo > '
    )
fi

[[ -z ${selected:-} ]] && exit 0

rel="${selected#"$GITHUB_ROOT"/}"
selected_name=$(printf '%s' "$rel" | tr '/.' '__')
tmux_running=$(pgrep tmux || true)

if [[ -z ${TMUX:-} && -z ${tmux_running:-} ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

if [[ -z ${TMUX:-} ]]; then
    tmux attach-session -t="$selected_name"
else
    tmux switch-client -t="$selected_name"
fi

#!/usr/bin/env bash
# Sync all github.com/n1ecC repositories into ~/Github/n1ecC/
# Usage:
#   sync-n1ecC          # clone missing + fast-forward pull existing
#   sync-n1ecC --list   # show local vs remote status
#   sync-n1ecC --pull   # pull only, skip new clones

set -euo pipefail

N1ECC_DIR="${N1ECC_DIR:-$HOME/Github/n1ecC}"
EXCLUDE_FILE="${GITHUB_ROOT:-$HOME/Github}/_tools/archive-exclude.txt"
MODE="${1:---sync}"

mkdir -p "$N1ECC_DIR"

is_excluded() {
  local name="$1"
  [[ -f "$EXCLUDE_FILE" ]] && grep -qxF "$name" "$EXCLUDE_FILE"
}

list_repos() {
  gh api user/repos --paginate \
    -q '.[] | select(.fork == false) | select(.name != "SystemDashboard") | .name' \
    | sort
}

clone_or_pull() {
  local name="$1"
  local path="${N1ECC_DIR}/${name}"
  local https_url="https://github.com/n1ecC/${name}.git"

  if [[ -d "${path}/.git" ]]; then
    echo ">> pull  ${name}"
    git -C "$path" remote set-url origin "$https_url"
    git -C "$path" fetch origin --prune
    current_branch="$(git -C "$path" symbolic-ref -q --short HEAD || true)"
    if [[ -n "$current_branch" ]]; then
      git -C "$path" pull --ff-only origin "$current_branch" || {
        echo "   WARN: ${name} pull failed (local changes or diverged branch?)"
      }
    fi
  else
    if is_excluded "$name"; then
      echo ">> skip  ${name} (archived locally — see archive-exclude.txt)"
      return 0
    fi
    echo ">> clone ${name}"
    gh repo clone "n1ecC/${name}" "$path"
  fi
}

case "$MODE" in
  --list)
    echo "Local n1ecC repos in ${N1ECC_DIR}:"
    while IFS= read -r name; do
      if [[ -d "${N1ECC_DIR}/${name}/.git" ]]; then
        branch="$(git -C "${N1ECC_DIR}/${name}" branch --show-current 2>/dev/null || echo "?")"
        dirty=""
        [[ -n "$(git -C "${N1ECC_DIR}/${name}" status --porcelain 2>/dev/null)" ]] && dirty=" *"
        echo "  [ok] ${name} (${branch})${dirty}"
      else
        echo "  [--] ${name}  (not cloned)"
      fi
    done < <(list_repos)
    ;;
  --pull)
    while IFS= read -r name; do
      [[ -d "${N1ECC_DIR}/${name}/.git" ]] && clone_or_pull "$name"
    done < <(list_repos)
    ;;
  --sync|*)
    echo "Syncing n1ecC repos -> ${N1ECC_DIR}"
    while IFS= read -r name; do
      clone_or_pull "$name" || echo "   WARN: skipped ${name} due to error"
    done < <(list_repos)
    echo "Done."
    ;;
esac

#!/usr/bin/env bash
# ==============================================================================
# wma — Workmux Add launcher (Active agyy by default, Headless with -b/--headless)
#
# Usage:
#   wma                     -> Interactive modal with agyy in single pane
#   wma <task>              -> Auto-names branch, injects context, starts agyy
#   wma <branch> [task]     -> Creates worktree with branch and starts agyy
#   wma <branch> -b         -> Creates headless worktree in background
# ==============================================================================
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/bin:$HOME/.local/bin:$PATH"

cmd_args=("$@")

has_bg=0
for arg in "${cmd_args[@]}"; do
  if [[ "$arg" == "-b" || "$arg" == "--background" || "$arg" == "--headless" || "$arg" == "-C" || "$arg" == "--no-pane-cmds" ]]; then
    has_bg=1
    break
  fi
done

# If no headless flags were passed, launch active worktree with agyy
if [[ $has_bg -eq 0 ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  exec "$SCRIPT_DIR/tmux-workmux-new" "${cmd_args[@]}"
fi

# Headless background creation
if [[ $# -eq 0 ]]; then
  echo "Usage: wma <branch-name> [options]"
  echo "Run 'workmux add --help' for available options."
  exit 1
fi

has_no_pane_cmds=0
for arg in "${cmd_args[@]}"; do
  if [[ "$arg" == "-C" || "$arg" == "--no-pane-cmds" ]]; then
    has_no_pane_cmds=1
    break
  fi
done

add_flags=()
[[ $has_bg -eq 0 ]] && add_flags+=("--background")
[[ $has_no_pane_cmds -eq 0 ]] && add_flags+=("--no-pane-cmds")

output=$(workmux add "${add_flags[@]}" "${cmd_args[@]}" 2>&1) || {
  status=$?
  echo "$output"
  exit $status
}

echo "$output"

# Extract the worktree handle/name from workmux output to close the window
target_handle=$(echo "$output" | sed -n -E "s/.*Successfully created worktree and tmux window for '([^']+)'.*/\1/p")
if [[ -z "$target_handle" ]]; then
  target_handle=$(echo "$output" | sed -n -E 's/.*Worktree:.*\.worktrees\/([^ ]+).*/\1/p')
fi

if [[ -n "$target_handle" ]]; then
  workmux close "$target_handle" >/dev/null 2>&1 || true
  echo "📦 Headless worktree ready: run 'wmo $target_handle' to open in tmux."
fi

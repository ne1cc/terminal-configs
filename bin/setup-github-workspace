#!/usr/bin/env bash
# Create ~/Github folder layout on any machine (macOS, Linux, WSL).
# Copies starter README/gitignores, links _tools scripts from terminal-configs.
# Called by install.sh, setup.sh, and platform bootstrap scripts.

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GITHUB_ROOT="${GITHUB_ROOT:-$HOME/Github}"
TEMPLATES="$DOTFILES/templates/github-workspace"

# Top-level and nested directories — same tree on every platform.
GITHUB_DIRS=(
  "$GITHUB_ROOT/ne1cc"
  "$GITHUB_ROOT/config/dotfiles"
  "$GITHUB_ROOT/config/scripts"
  "$GITHUB_ROOT/config/analytics"
  "$GITHUB_ROOT/config/docs"
  "$GITHUB_ROOT/config/external"
  "$GITHUB_ROOT/config/local"
  "$GITHUB_ROOT/explore"
  "$GITHUB_ROOT/archive"
  "$GITHUB_ROOT/tracking"
  "$GITHUB_ROOT/_tools"
  "$GITHUB_ROOT/workspace/msba"
  "$GITHUB_ROOT/workspace/sandboxes"
  "$GITHUB_ROOT/workspace/datasets"
)

GITHUB_SCRIPTS=(
  sync-ne1cc
  gharchive
  pin-portfolio
  setup-github-profile
  setup-github-workspace
)

install_template() {
  local src="$1"
  local dest="$2"
  if [[ -f "$src" && ! -f "$dest" ]]; then
    cp "$src" "$dest"
    echo "  created: $dest"
  fi
}

echo "==> Github workspace -> ${GITHUB_ROOT}"

for dir in "${GITHUB_DIRS[@]}"; do
  mkdir -p "$dir"
done
echo "  directories: ${#GITHUB_DIRS[@]} paths ensured"

install_template "$TEMPLATES/README.md" "$GITHUB_ROOT/README.md"
install_template "$TEMPLATES/config.README.md" "$GITHUB_ROOT/config/README.md"
install_template "$TEMPLATES/archive.MANIFEST.md" "$GITHUB_ROOT/archive/MANIFEST.md"
install_template "$TEMPLATES/archive-exclude.txt" "$GITHUB_ROOT/_tools/archive-exclude.txt"
install_template "$TEMPLATES/workspace.gitignore" "$GITHUB_ROOT/workspace/.gitignore"
install_template "$TEMPLATES/datasets.gitignore" "$GITHUB_ROOT/workspace/datasets/.gitignore"
install_template "$TEMPLATES/datasets.README.md" "$GITHUB_ROOT/workspace/datasets/README.md"

touch "$GITHUB_ROOT/_tools/archive-exclude.txt"

for script in "${GITHUB_SCRIPTS[@]}"; do
  if [[ -e "$DOTFILES/bin/$script" ]]; then
    ln -sf "$DOTFILES/bin/$script" "$GITHUB_ROOT/_tools/$script"
    echo "  linked: _tools/$script"
    # Remove legacy duplicate scripts from before terminal-configs port.
    [[ -f "$GITHUB_ROOT/_tools/${script}.sh" && ! -L "$GITHUB_ROOT/_tools/${script}.sh" ]] && {
      rm -f "$GITHUB_ROOT/_tools/${script}.sh"
      echo "  removed legacy: _tools/${script}.sh"
    }
  fi
done

if [[ "${1:-}" == "--sync" ]]; then
  "$DOTFILES/bin/sync-ne1cc"
elif [[ "${1:-}" == "--rename" ]]; then
  "$DOTFILES/bin/sync-ne1cc" --rename
fi

echo "Done. Run: source ~/.zshrc  then  ghsync-list"

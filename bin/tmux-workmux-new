#!/usr/bin/env bash
# tmux-workmux-new — interactive modal launcher for workmux + Claude
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/bin:$HOME/.local/bin:$PATH"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: Must be inside a git repository."
  read -n 1 -s -r -p "Press any key to exit..."
  exit 1
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " 🚀 LAUNCH CLAUDE WORKTREE (workmux)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
printf "Enter new branch name (e.g. feat/auth, fix/styles):\n> "
read -r branch

if [[ -z "${branch:-}" ]]; then
  echo "Branch name cannot be empty."
  exit 0
fi

# Sanitize branch name (spaces to hyphens)
branch="${branch// /-}"

echo ""
printf "Prompt for Claude (optional, leave empty for interactive):\n> "
read -r prompt

echo ""
if [[ -n "${prompt:-}" ]]; then
  echo "==> Creating worktree '$branch' and dispatching Claude prompt..."
  workmux add "$branch" -A "$prompt"
else
  echo "==> Creating worktree '$branch' with Neovim + Claude..."
  workmux add "$branch"
fi

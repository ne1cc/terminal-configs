#!/usr/bin/env python3
"""
tmux-open-link: Universal terminal link and file opener for Shift+Click in Tmux.
Resolves explicit OSC 8 hyperlinks, inline HTTP/HTTPS URLs, Markdown links,
and local file paths from the clicked terminal row and cursor column.
"""

import sys
import os
import re
import subprocess
import shutil
from pathlib import Path


def get_system_opener(target: str):
    """Determine the correct system opener command for the target URL or path."""
    if sys.platform == "darwin":
        return ["open", target]
    
    # Check for WSL (Windows Subsystem for Linux)
    if "microsoft" in Path("/proc/version").read_text(errors="ignore").lower() if Path("/proc/version").exists() else False:
        if shutil.which("wslview"):
            return ["wslview", target]
        if shutil.which("open.exe"):
            return ["open.exe", target]
        return ["cmd.exe", "/c", "start", '""', target]
    
    # Standard Linux
    if shutil.which("xdg-open"):
        return ["xdg-open", target]
    
    # Fallback
    return ["open", target]


def notify_tmux(message: str):
    """Display a status notification toast in tmux."""
    if "TMUX" in os.environ:
        subprocess.run(
            ["tmux", "display-message", message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def clean_url(url: str) -> str:
    """Strip common trailing punctuation from terminal text matching."""
    return url.rstrip(".,;:!?)>\"'`")


def resolve_target(hyperlink: str, line: str, col: int) -> str | None:
    """Resolve the URL or file path under cursor column col."""
    # 1. Explicit OSC 8 hyperlink from tmux #{mouse_hyperlink}
    if hyperlink and hyperlink.strip():
        return hyperlink.strip()

    if not line:
        return None

    # 2. Markdown link syntax: [title](url)
    md_pattern = re.compile(r'\[([^\]]+)\]\(([^)]+)\)')
    for m in md_pattern.finditer(line):
        if m.start() <= col <= m.end():
            return clean_url(m.group(2).strip())

    # 3. Explicit URI scheme regex (http, https, ftp, file, git, ssh)
    url_pattern = re.compile(
        r'(?i)\b((?:https?://|ftp://|file://|git://|ssh://)[^\s<>"\'`]+)'
    )
    url_matches = []
    for m in url_pattern.finditer(line):
        raw = m.group(1)
        cleaned = clean_url(raw)
        start = m.start()
        end = start + len(cleaned)
        url_matches.append((start, end, cleaned))
        if start <= col <= end:
            return cleaned

    # 4. Local file path regex (/path, ~/path, ./path, ../path, word/path.ext)
    file_pattern = re.compile(
        r'(?:^|[\s"\'`\(<\[])(/[^:\s<>"\'`\)]+|~/[^:\s<>"\'`\)]+|\.{1,2}/[^:\s<>"\'`\)]+|[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+\.[a-zA-Z0-9_]+)(?::(\d+))?'
    )
    file_matches = []
    for m in file_pattern.finditer(line):
        path_str = m.group(1)
        line_num = m.group(2)
        start = m.start(1)
        end = m.end(1)
        expanded = os.path.expanduser(path_str)
        if os.path.exists(expanded):
            file_matches.append((start, end, expanded, line_num))
            if start <= col <= end:
                return expanded

    # 5. Proximity fallback: If mouse was clicked on the row with URLs
    if url_matches:
        # If there is only one URL on the line, assume user intended to open it
        if len(url_matches) == 1:
            return url_matches[0][2]
        # Otherwise choose the closest URL to the click column
        closest = min(url_matches, key=lambda item: abs(item[0] - col))
        return closest[2]

    # 6. Proximity fallback for local files
    if file_matches:
        if len(file_matches) == 1:
            return file_matches[0][2]
        closest_file = min(file_matches, key=lambda item: abs(item[0] - col))
        return closest_file[2]

    return None


def main():
    hyperlink = sys.argv[1] if len(sys.argv) > 1 else ""
    line = sys.argv[2] if len(sys.argv) > 2 else ""
    try:
        col = int(sys.argv[3]) if len(sys.argv) > 3 else 0
    except ValueError:
        col = 0

    target = resolve_target(hyperlink, line, col)

    if not target:
        notify_tmux("⚠️  No link or file path found under cursor")
        sys.exit(0)

    # Format notification display text (truncate if overly long)
    disp = target if len(target) <= 60 else target[:57] + "..."

    cmd = get_system_opener(target)
    try:
        subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        notify_tmux(f"🔗 Opened: {disp}")
    except Exception as err:
        notify_tmux(f"❌ Failed to open {disp}: {err}")
        sys.exit(1)


if __name__ == "__main__":
    main()

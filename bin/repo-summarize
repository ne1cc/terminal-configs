#!/usr/bin/env bash
# ==============================================================================
# repo-summarize — Headless repository file summarizer powered by Antigravity (agyy)
#
# Scans a project or directory, discovers key implementation files using smart
# heuristics, streams them through Antigravity (agyy -p), writes complete
# architectural and syntactic explanations to docs/explanations/<filename>.md,
# compiles an INDEX.md navigation guide, and optionally opens in One Markdown.
#
# Usage:
#   repo-summarize                     # summarize current git repository
#   repo-summarize /path/to/repo       # target specific repository
#   repo-summarize --open              # open INDEX.md in One Markdown upon finish
#   repo-summarize --dry-run           # show discovered files without calling AI
#   repo-summarize --max-files 15      # process up to 15 files (default: 20)
#   repo-summarize --force             # overwrite existing explanations
# ==============================================================================

set -euo pipefail

OPEN_IN_OMD=false
DRY_RUN=false
FORCE=false
MAX_FILES=20
TARGET_DIR=""
FILTER=""

usage() {
  sed -n '2,17p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--open) OPEN_IN_OMD=true; shift ;;
    -n|--dry-run) DRY_RUN=true; shift ;;
    -f|--force) FORCE=true; shift ;;
    -m|--max-files)
      MAX_FILES="${2:-20}"
      shift 2
      ;;
    --filter)
      FILTER="${2:-}"
      shift 2
      ;;
    -h|--help) usage 0 ;;
    -*)
      echo "Unknown option: $1" >&2
      usage 1
      ;;
    *)
      if [[ -z "$TARGET_DIR" ]]; then
        TARGET_DIR="$1"
        shift
      else
        echo "Unexpected argument: $1" >&2
        usage 1
      fi
      ;;
  esac
done

# Resolve target directory
if [[ -z "$TARGET_DIR" ]]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    TARGET_DIR="$(git rev-parse --show-toplevel)"
  else
    TARGET_DIR="$(pwd)"
  fi
else
  TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
fi

cd "$TARGET_DIR"
REPO_NAME="$(basename "$TARGET_DIR")"
DOCS_DIR="$TARGET_DIR/docs/explanations"
INDEX_FILE="$DOCS_DIR/INDEX.md"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " 📚 Antigravity Headless Repo Summarizer (agyy)"
echo " Target : $TARGET_DIR"
echo " Docs   : docs/explanations/"
echo " Limit  : $MAX_FILES files"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Ensure docs directory exists
mkdir -p "$DOCS_DIR"

# Discover files using fd or git ls-files
find_files() {
  if command -v fd >/dev/null 2>&1; then
    fd -t f \
      -E ".git" \
      -E "node_modules" \
      -E ".venv" \
      -E "venv" \
      -E "__pycache__" \
      -E ".worktrees" \
      -E "dist" \
      -E "build" \
      -E "target" \
      -E "vendor" \
      -E "coverage" \
      -E ".next" \
      -E ".turbo" \
      -E "lazy-lock.json" \
      -E "package-lock.json" \
      -E "yarn.lock" \
      -E "pnpm-lock.yaml" \
      -E "poetry.lock" \
      -E "uv.lock" \
      -E "Cargo.lock" \
      -E "Gemfile.lock" \
      -E "*.min.js" \
      -E "*.min.css" \
      -E "*.map" \
      -E "*.svg" \
      -E "*.png" \
      -E "*.jpg" \
      -E "*.jpeg" \
      -E "*.gif" \
      -E "*.ico" \
      -E "*.woff*" \
      -E "*.ttf" \
      -E "docs/explanations/*" \
      -e py -e ts -e tsx -e js -e jsx -e go -e rs -e lua -e sh -e zsh -e sql -e cpp -e c -e h -e java \
      . "$TARGET_DIR"
  elif git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git ls-files | grep -E '\.(py|ts|tsx|js|jsx|go|rs|lua|sh|zsh|sql|cpp|c|h|java)$' | grep -vE '(node_modules|\.venv|dist/|build/|target/|docs/explanations/)'
  else
    find . -type f \( -name "*.py" -o -name "*.ts" -o -name "*.js" -o -name "*.go" -o -name "*.rs" -o -name "*.lua" -o -name "*.sh" \) | sed 's|^\./||'
  fi
}

# Collect candidate files
ALL_CANDIDATES=()
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  rel_path="${f#"$TARGET_DIR"/}"
  rel_path="${rel_path#./}"
  
  if [[ -n "$FILTER" ]] && [[ "$rel_path" != *"$FILTER"* ]]; then
    continue
  fi
  ALL_CANDIDATES+=("$rel_path")
done < <(find_files)

if [[ ${#ALL_CANDIDATES[@]} -eq 0 ]]; then
  echo "No relevant code files discovered under $TARGET_DIR."
  exit 0
fi

# Sort by priority: Entrypoints and configs first, then core logic
score_file() {
  local p="$1"
  local base
  base="$(basename "$p")"
  if [[ "$base" =~ ^(main|app|index|server|cli|setup|init|entry)\. ]]; then
    echo "10 $p"
  elif [[ "$p" =~ ^(src/|lib/|pkg/|core/) ]]; then
    echo "20 $p"
  elif [[ "$p" =~ tests?/ ]]; then
    echo "80 $p"
  else
    echo "50 $p"
  fi
}

SORTED_FILES=()
while IFS= read -r line; do
  SORTED_FILES+=("${line#* }")
done < <(
  for f in "${ALL_CANDIDATES[@]}"; do
    score_file "$f"
  done | sort -k1,1n -k2,2
)

# Truncate to MAX_FILES
FILES_TO_PROCESS=("${SORTED_FILES[@]:0:$MAX_FILES}")

echo "Discovered ${#ALL_CANDIDATES[@]} candidate files. Selected top ${#FILES_TO_PROCESS[@]} for summarization:"
for f in "${FILES_TO_PROCESS[@]}"; do
  echo "  • $f"
done
echo ""

if "$DRY_RUN"; then
  echo "Dry-run complete. Exiting without generating summaries."
  exit 0
fi

if ! command -v agyy >/dev/null 2>&1; then
  echo "Error: 'agyy' (or 'agy') command not found in PATH." >&2
  exit 1
fi

INDEX_ENTRIES=()
MERMAID_ENTRIES=()

for rel in "${FILES_TO_PROCESS[@]}"; do
  doc_rel="docs/explanations/${rel}.md"
  doc_full="$TARGET_DIR/$doc_rel"
  mkdir -p "$(dirname "$doc_full")"

  ext="${rel##*.}"
  base_clean="$(basename "$rel" | tr '.' '_' | tr '-' '_')"
  MERMAID_ENTRIES+=("    $base_clean[\"$rel\"]")

  if [[ -f "$doc_full" && "$FORCE" != "true" ]]; then
    echo "⏩ Skip: $rel (already exists: $doc_rel)"
    INDEX_ENTRIES+=("- [**\`$rel\`**](${rel}.md) — *(Cached explanation)*")
    continue
  fi

  echo "🧠 Summarizing: $rel -> $doc_rel ..."

  # Read file content safely
  file_content="$(cat "$TARGET_DIR/$rel" 2>/dev/null || true)"

  tmp_prompt="$(mktemp /tmp/agyy_prompt.XXXXXX)"
  cat << EOF > "$tmp_prompt"
You are a senior principal systems architect. Provide a deep, comprehensive technical explanation of the source file '$rel' from repository '$REPO_NAME'.

Source File Content:
\`\`\`$ext
$file_content
\`\`\`

Structure your explanation with:
1. **Executive Summary & System Role**: Core purpose, problem solved, and responsibilities.
2. **Architecture & Design Patterns**: Internal structure, state management, and algorithmic patterns.
3. **Public APIs & Interfaces**: Key classes, structs, methods, parameters, return types, and contracts.
4. **Data Flow & Dependencies**: External imports, input pipelines, transformation logic, and side effects.
5. **Notable Edge Cases & Constraints**: Error boundaries, concurrency, and operational trade-offs.

Format in clean GitHub-Flavored Markdown. Do NOT wrap the entire document in a single outer code block.
EOF

  RESPONSE="$(agyy -p "$(cat "$tmp_prompt")" 2>/dev/null || agyy -p "Explain architecture of $rel")"
  rm -f "$tmp_prompt"

  cat << EOF > "$doc_full"
# Architecture & Code Explanation: \`$rel\`

> **Source File**: [\`$rel\`](../../$rel)  
> **Repository**: \`$REPO_NAME\`  
> **Generated**: $(date +"%Y-%m-%d %H:%M:%S") via \`agyy\`  

---

$RESPONSE
EOF

  INDEX_ENTRIES+=("- [**\`$rel\`**](${rel}.md)")
  echo "  ✓ Saved: $doc_rel"
done

# Generate Master INDEX.md with Mermaid Diagram
cat << EOF > "$INDEX_FILE"
# $REPO_NAME — Repository Architecture & File Explanations

> Generated on $(date +"%Y-%m-%d %H:%M:%S") using [Antigravity \`agyy\`](https://github.com/ne1cc/terminal-configs)

## 🗺️ System Map

\`\`\`mermaid
flowchart TD
    subgraph Repo ["$REPO_NAME Modules"]
$(printf '%s\n' "${MERMAID_ENTRIES[@]}")
    end
\`\`\`

## 📚 Documented Files

EOF

for entry in "${INDEX_ENTRIES[@]}"; do
  echo "$entry" >> "$INDEX_FILE"
done

cat << EOF >> "$INDEX_FILE"

---

*To regenerate all explanations with latest changes: \`repo-summarize --force --open\`*
EOF

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✓ All summaries generated successfully!"
echo "  Index: $INDEX_FILE"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if "$OPEN_IN_OMD"; then
  if command -v omd >/dev/null 2>&1; then
    echo "Opening $INDEX_FILE in One Markdown..."
    omd "$INDEX_FILE"
  elif [[ "$OSTYPE" == darwin* ]]; then
    open -a "One Markdown" "$INDEX_FILE" 2>/dev/null || open "$INDEX_FILE"
  else
    glow -p "$INDEX_FILE" 2>/dev/null || xdg-open "$INDEX_FILE" 2>/dev/null || true
  fi
fi

#!/usr/bin/env bash
# tmux-workmux-remove — interactive modal worktree remover & pruner using fzf and workmux
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/bin:$HOME/.local/bin:$PATH"

# Resolve active pane directory if launched inside tmux
if [[ -n "${TMUX_PANE:-}" ]]; then
  TARGET_DIR=$(tmux display-message -p -t "$TMUX_PANE" "#{pane_current_path}" 2>/dev/null || true)
  if [[ -n "${TARGET_DIR:-}" && -d "$TARGET_DIR" ]]; then
    cd "$TARGET_DIR"
  fi
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: Must be inside a git repository."
  read -n 1 -s -r -p "Press any key to exit..."
  exit 1
fi

MAIN_INFO=$(git worktree list | head -n 1)
MAIN_PATH=$(echo "$MAIN_INFO" | awk '{print $1}')
MAIN_BRANCH=$(echo "$MAIN_INFO" | sed -E 's/.*\[(.*)\].*/\1/')

WT_LIST=$(workmux list 2>/dev/null | awk -v mb="$MAIN_BRANCH" 'NR==1 || ($1 != mb && $1 != "")')

COUNT=$(echo "$WT_LIST" | tail -n +2 | wc -l | tr -d ' ')
if [[ "$COUNT" -eq 0 ]]; then
  echo "No removable worktrees found."
  read -n 1 -s -r -p "Press any key to exit..."
  exit 0
fi

SELECTED_OUTPUT=$(echo "$WT_LIST" | fzf -m \
  --header-lines=1 \
  --prompt="Select worktree(s) to remove > " \
  --header="TAB: multi-select | ENTER: confirm removal | ESC: cancel" \
  --reverse)

if [[ -z "$SELECTED_OUTPUT" ]]; then
  exit 0
fi

mapfile -t SELECTED < <(echo "$SELECTED_OUTPUT" | awk '{print $1}')

if [[ ${#SELECTED[@]} -eq 0 ]]; then
  exit 0
fi

# If currently inside one of the worktrees to be removed, go to repo root
CUR_DIR=$(pwd -P)
for b in "${SELECTED[@]}"; do
  wt_path=$(workmux path "$b" 2>/dev/null || true)
  if [[ -n "$wt_path" && -d "$wt_path" ]]; then
    wt_real=$(cd "$wt_path" 2>/dev/null && pwd -P || echo "$wt_path")
    if [[ "$CUR_DIR" == "$wt_real"* ]]; then
      cd "$MAIN_PATH"
      break
    fi
  fi
done

echo ""
echo "==> Removing worktree(s): ${SELECTED[*]}"
workmux remove "${SELECTED[@]}"
echo "==> Pruning git worktrees..."
git worktree prune
echo "✓ Done."
sleep 1

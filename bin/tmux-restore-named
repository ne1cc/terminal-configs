#!/usr/bin/env bash

export PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/bin:$HOME/.local/bin:$PATH"
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"

mkdir -p ~/.tmux/resurrect

# Find all snapshot .txt files sorted by modification time (newest first)
cd ~/.tmux/resurrect || exit 1
files=$(ls -t *.txt 2>/dev/null)

if [[ -z "$files" ]]; then
    echo "No snapshots found in ~/.tmux/resurrect/"
    read -rp "Press Enter to exit..."
    exit 0
fi

# Run fzf interactively
selected_file=$(echo "$files" | fzf --reverse --header "Select Snapshot to Restore (ESC to cancel)" --prompt "Restore > ")

if [[ -n "$selected_file" ]]; then
    cp "$selected_file" ~/.tmux/resurrect/last
    ~/.tmux/plugins/tmux-resurrect/scripts/restore.sh
    tmux display-message "✓ Restored snapshot: $selected_file"
fi

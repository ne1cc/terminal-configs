#!/usr/bin/env bash
# ==============================================================================
# session-handoff — Generate clean, structured markdown session handoffs
# ==============================================================================
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/bin:$HOME/.local/bin:$PATH"

TOPIC="${1:-}"
if [ -z "$TOPIC" ]; then
    if [ -n "${TMUX:-}" ]; then
        TOPIC="$(tmux display-message -p '#{session_name}-#{window_name}')"
    else
        TOPIC="$(basename "$(pwd)")"
    fi
fi

# Clean topic string for filename
SAFE_TOPIC=$(echo "$TOPIC" | tr ' /:' '---' | tr -cd 'A-Za-z0-9_-')
DATE_STR=$(date +%Y-%m-%d)
TIME_STR=$(date +%H:%M:%S)
OUTFILE=".claude/memory/sessions/${DATE_STR}-${SAFE_TOPIC}.md"

# If inside a git repo, save inside the repo; otherwise save to ~/tmux-logs/
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    OUTFILE="$HOME/tmux-logs/handoff-${DATE_STR}-${SAFE_TOPIC}.md"
fi

mkdir -p "$(dirname "$OUTFILE")"

{
    echo "# Session Handoff: ${SAFE_TOPIC}"
    echo "**Timestamp**: ${DATE_STR} ${TIME_STR}"
    echo "**Working Directory**: \`$(pwd)\`"
    
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "**Git Branch**: \`$(git branch --show-current 2>/dev/null || echo 'detached')\`"
        echo "**Latest Commit**: \`$(git log -1 --oneline 2>/dev/null || echo 'none')\`"
        echo ""
        echo "## 📊 Git Status"
        echo '```'
        git status -sb 2>/dev/null || true
        echo '```'
        echo ""
        echo "## 📝 Uncommitted Diffs Summary"
        echo '```'
        git diff --stat 2>/dev/null || true
        echo '```'
    fi

    if [ -n "${TMUX:-}" ]; then
        echo ""
        echo "## 🖥️ Active Tmux Session State"
        echo "- **Session**: \`$(tmux display-message -p '#{session_name}')\`"
        echo "- **Window**: \`$(tmux display-message -p '#{window_index}: #{window_name}')\`"
        echo "- **Active Panes**: \`$(tmux list-panes | wc -l | tr -d ' ')\`"
    fi

    echo ""
    echo "## 📌 Next Steps & Open Tasks"
    echo "- [ ] Review changes and verify test suite"
    echo "- [ ] Continue next implementation milestone"
} > "$OUTFILE"

if [ -n "${TMUX:-}" ]; then
    tmux display-message "✓ Saved session handoff to $OUTFILE"
else
    echo "✓ Saved session handoff to $OUTFILE"
fi

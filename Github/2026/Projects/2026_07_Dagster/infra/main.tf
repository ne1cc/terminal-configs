terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    bucket = "ab-testing-dagster-tfstate"
    key    = "dagster/terraform.tfstate"
    region = "us-east-1"
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "ab-testing-dagster"
      Environment = var.environment
      ManagedBy   = "terraform"
    }
  }
}

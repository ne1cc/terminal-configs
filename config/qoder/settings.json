{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux register-agent"
          },
          {
            "type": "command",
            "command": "bash -c 'git rev-parse --is-inside-work-tree &>/dev/null || exit 0; branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); [[ \"$branch\" == \"main\" || \"$branch\" == \"HEAD\" ]] && exit 0; echo \"🔄 Syncing $branch with origin/main...\"; git fetch origin main 2>&1 && git rebase origin/main 2>&1 && echo \"✅ Worktree is up to date with origin/main\" || { echo \"⚠️  Rebase conflict on $branch — resolve with: git rebase --continue (or --abort)\"; exit 1; }'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "ask-matt": "user-invocable-only",
    "claude-handoff": "user-invocable-only",
    "claude-security": "user-invocable-only",
    "grill-me": "user-invocable-only",
    "grill-with-docs": "user-invocable-only",
    "implement": "user-invocable-only",
    "implement-spec": "user-invocable-only",
    "improve-codebase-architecture": "user-invocable-only",
    "loop-me": "user-invocable-only",
    "retro": "user-invocable-only",
    "setup-matt-pocock-skills": "user-invocable-only",
    "setup-ts-deep-modules": "user-invocable-only",
    "teach": "user-invocable-only",
    "to-questionnaire": "user-invocable-only",
    "to-spec": "user-invocable-only",
    "to-tickets": "user-invocable-only",
    "triage": "user-invocable-only",
    "wait-what": "user-invocable-only",
    "wayfinder": "user-invocable-only",
    "writing-beats": "user-invocable-only",
    "writing-fragments": "user-invocable-only",
    "writing-shape": "user-invocable-only"
  },
  "securityScan": {
    "l1StaticCheck": true,
    "l2LightweightScan": true,
    "l3DeepScan": true
  },
  "permissions": {
    "additionalDirectories": [],
    "trustDirectories": [
      "/Users/alex"
    ]
  },
  "security": {
    "auth": {
      "selectedType": "qoder-browser"
    }
  },
  "model": {
    "name": "gfmodel"
  }
}